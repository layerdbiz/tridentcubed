+// Trident (#397): one trace cache for every function of a build, so each package is read and parsed once
+// instead of once per function.
+/** @type {Record<string, Map<string, unknown>>} */
+const nft_cache = {};
+
+/**
+ * The adapter writes its entry files (`vercel-tmp/index.js`, `server.js`, `serverless.js`) anew for every
+ * function, so the cache forgets them before each trace.
+ * @param {string} tmp_dir
+ */
+function forget_entry_files(tmp_dir) {
+	for (const map of Object.values(nft_cache)) {
+		for (const file of map.keys()) {
+			if (file.startsWith(tmp_dir)) map.delete(file);
+		}
+	}
+}
