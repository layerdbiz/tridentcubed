{
	"$schema": "https://v2-11-6.turborepo.dev/schema.json",
	"agentGuidance": false,
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["//#barrels", "^build"],
			"outputs": ["dist/**", ".svelte-kit/**", "!**/.svelte-kit/cache/**"]
		},
		"styles": {
			"cache": true,
			"outputs": ["dist/ui.css"]
		},
		"//#barrels:watch": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"inputs": [
				"packages/ui/src/lib/**",
				"!packages/ui/src/lib/index.ts",
				"apps/*/src/lib/**",
				"!apps/*/src/lib/index.ts"
			],
			"outputs": ["packages/ui/src/lib/index.ts", "apps/*/src/lib/index.ts"]
		},
		"//#barrels": {
			"cache": false,
			"inputs": [
				"packages/ui/src/lib/**",
				"!packages/ui/src/lib/index.ts",
				"apps/*/src/lib/**",
				"!apps/*/src/lib/index.ts"
			],
			"outputs": ["packages/ui/src/lib/index.ts", "apps/*/src/lib/index.ts"]
		},
		"components": {
			"dependsOn": ["//#barrels"],
			"cache": true,
			"outputs": ["dist/**", "!dist/**/*.css"]
		},
		"preview": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"outputs": []
		},
		"sync": {
			"cache": false
		},
		"symlinks": {
			"inputs": ["packages/ui/static/**"],
			"cache": false,
			"outputs": ["apps/*/static"]
		},
		"symlinks:clean": {
			"cache": false
		},
		"symlinks:check": {
			"cache": false
		}
	}
}
