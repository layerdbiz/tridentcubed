{
	"name": "@layerd/tools",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"barrels": "./bin/barrels.js",
		"sheetari": "./bin/sheetari.js",
		"stories": "./bin/stories.js",
		"symlinks": "./bin/symlinks.js",
		"types": "./src/main.ts",
		"workspace": "./bin/workspace.js"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./barrels": "./src/generators/barrels.ts",
		"./sheetari": "./src/generators/sheetari.ts",
		"./stories": "./src/generators/stories.ts",
		"./symlinks": "./src/generators/symlinks.ts",
		"./types": "./src/generators/types.ts",
		"./workspace": "./src/generators/workspace-launcher.ts"
	},
	"scripts": {
		"barrels:run": "node ./bin/barrels.js",
		"sheetari": "node bin/sheetari.js",
		"stories": "stories",
		"story": "node bin/stories.js",
		"symlinks": "node bin/symlinks.js",
		"symlinks:clean": "node -e \"import('./src/generators/symlinks.ts').then(m => m.cleanSymlinks())\"",
		"symlinks:check": "node -e \"import('./src/generators/symlinks.ts').then(m => m.checkSymlinks())\"",
		"workspace": "node ./bin/workspace.js",
		"types": "types",
		"test": "node ./bin/barrels.js"
	},
	"devDependencies": {
		"@types/node": "^25.2.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"chokidar": "^5.0.0",
		"glob": "^13.0.1"
	}
}