{
	"name": "@layerd/ui",
	"version": "0.0.1",
	"imports": {
		"#ui.css": "./src/lib/ui.css"
	},
	"scripts": {
		"dev": "svelte-kit sync",
		"dev:build": "svelte-package -i src/lib --watch || pnpm dev:build",
		"build": "svelte-kit sync && pnpm styles && pnpm components",
		"styles": "postcss ./src/lib/ui.css -o ./dist/ui.css",
		"components": "svelte-package -i src/lib",
		"sync": "svelte-kit sync",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "pnpm build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"files": [
		"dist",
		"src/lib",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"style": "./dist/ui.css",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"style": "./dist/ui.css",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./src": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"import": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./package.json": "./package.json",
		"./ui.css": "./dist/ui.css",
		"./theme.css": "./src/lib/ui.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@csstools/postcss-light-dark-function": "^3.0.0",
		"@iconify-json/flagpack": "^1.2.7",
		"@iconify/tailwind4": "^1.2.1",
		"@layerd/config-svelte": "workspace:*",
		"@layerd/config-ts": "workspace:*",
		"@layerd/config-vite": "workspace:*",
		"@layerd/tools": "workspace:*",
		"@sveltejs/adapter-vercel": "^6.3.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
		"@tailwindcss/cli": "4.1.18",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "4.1.18",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-shape": "^3.1.8",
		"@types/three": "^0.182.0",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"svelte": "^5.50.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@dnd-kit/dom": "0.1.21",
		"@fontsource-variable/asta-sans": "^5.2.4",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@iconify-json/carbon": "^1.2.18",
		"@iconify-json/devicon": "^1.2.58",
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify-json/logos": "^1.2.10",
		"@iconify-json/material-symbols": "^1.2.54",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/solar": "^1.2.5",
		"@iconify-json/streamline-logos": "^1.2.0",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@sveltejs/kit": "^2.50.2",
		"d3-hierarchy": "^3.1.2",
		"d3-shape": "^3.2.0",
		"embla-carousel": "^8.6.0",
		"embla-carousel-auto-scroll": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-class-names": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"globe.gl": "^2.45.0",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"three": "^0.182.0"
	},
	"browserslist": [
		">0.5%",
		"last 2 versions",
		"iOS >= 12"
	]
}