<script lang="ts">
	/**
	 * @tags forms, input, textfield, icon, label
	 * @layout horizontal
	 */
	import type { HTMLInputAttributes } from 'svelte/elements';
	import { Component, type ComponentProps, type ComponentReturn, Icon, text } from '@layerd/ui';

	const uid = $props.id();

	export type InputNewProps = Omit<ComponentProps, 'disabled'> & {
		// component
		label?: string;
		variant?: 'text' | 'icon text' | 'text icon' | 'icon text icon';
		icon?: string;
		iconEnd?: string;
		// input
		type?: HTMLInputAttributes['type'];
		value?: HTMLInputAttributes['value'];
		placeholder?: HTMLInputAttributes['placeholder'];
		disabled?: boolean;
		required?: HTMLInputAttributes['required'];
		readonly?: HTMLInputAttributes['readonly'];
		pattern?: HTMLInputAttributes['pattern'];
		min?: HTMLInputAttributes['min'];
		max?: HTMLInputAttributes['max'];
		step?: HTMLInputAttributes['step'];
		minlength?: HTMLInputAttributes['minlength'];
		maxlength?: HTMLInputAttributes['maxlength'];
		inputmode?: HTMLInputAttributes['inputmode'];
		autocomplete?: HTMLInputAttributes['autocomplete'];
		autocorrect?: HTMLInputAttributes['autocorrect'];
		autocapitalize?: HTMLInputAttributes['autocapitalize'];
		spellcheck?: HTMLInputAttributes['spellcheck'];
		'aria-describedby'?: HTMLInputAttributes['aria-describedby'];
		'aria-invalid'?: HTMLInputAttributes['aria-invalid'];
	};

	let {
		variant = 'text',
		label = 'Text',
		icon = undefined,
		iconEnd = undefined,
		type = 'text',
		value = $bindable(),
		placeholder = ' ',
		disabled = false,
		required = false,
		readonly = false,
		pattern = undefined,
		min = undefined,
		max = undefined,
		step = undefined,
		minlength = undefined,
		maxlength = undefined,
		inputmode = undefined,
		autocomplete = undefined,
		autocorrect = 'off',
		autocapitalize = 'off',
		spellcheck = false,
		'aria-describedby': ariaDescribedby = undefined,
		'aria-invalid': ariaInvalid = undefined,
		...props
	}: InputNewProps = $props();

	const labelText = $derived(label?.trim() || 'Text');
	const field = $derived.by(() => {
		const name = text.camel(labelText);
		const id = text.camel(`input ${type} ${labelText} ${uid}`);

		return {
			name,
			id
		};
	});
	const trailingIcon = $derived(iconEnd || icon);
</script>

<!-- INPUT STATE EMOJIS
-----------------------------------------------------------------------------------------------------
Use thse emojis for comments about the state of the input in the examples below.

1. Content: ⬜ empty, ⬛ value, 💬 placeholder-shown, 🤖 autofill
2. Interaction: ⚪ blur, 🟡 hover, 🔵 focus, 🔵👁️ focus-visible, 🔵📦 focus-within, 🟣 active
3. Validation: ✅ valid, ✅👤 user-valid, ❌ invalid, ❌👤 user-invalid
4. Constraints: 🔒 required, 🔲 optional, 📖 readonly, 🚫 disabled, ↗️ open
-->

{#snippet leadingIcon()}
	{#if icon}
		<Icon icon={icon} class="icon start" />
	{/if}
{/snippet}

{#snippet trailingIconSnippet()}
	{#if trailingIcon}
		<Icon icon={trailingIcon} class="icon end" />
	{/if}
{/snippet}

{#snippet inputElement()}
	<input
		{type}
		bind:value
		{placeholder}
		name={field.name}
		id={field.id}
		aria-describedby={ariaDescribedby}
		aria-invalid={ariaInvalid}
		aria-required={required || undefined}
		{disabled}
		{required}
		{readonly}
		{pattern}
		{min}
		{max}
		{step}
		{minlength}
		{maxlength}
		{inputmode}
		{autocomplete}
		{autocorrect}
		{autocapitalize}
		{spellcheck}
	/>
{/snippet}

{#snippet textVariant()}
	{@render inputElement()}
{/snippet}

{#snippet iconTextVariant()}
	{@render leadingIcon()}
	{@render inputElement()}
{/snippet}

{#snippet textIconVariant()}
	{@render inputElement()}
	{@render trailingIconSnippet()}
{/snippet}

{#snippet iconTextIconVariant()}
	{@render leadingIcon()}
	{@render inputElement()}
	{@render trailingIconSnippet()}
{/snippet}

<Component {...props}>
	{#snippet component({ props }: { props: ComponentReturn })}
		<fieldset {...props}>
			<legend>{labelText}</legend>
			<label for={field.id}>
				{#if variant === 'icon text'}
					{@render iconTextVariant()}
				{:else if variant === 'text icon'}
					{@render textIconVariant()}
				{:else if variant === 'icon text icon'}
					{@render iconTextIconVariant()}
				{:else}
					{@render textVariant()}
				{/if}
			</label>
		</fieldset>
	{/snippet}
</Component>

<style lang="postcss">
	@reference "#ui.css";

	/* Notch / border model
	************************************************************/
	/*
		This keeps InputNew's border mechanics intact.
		1. Empty fields show the shell through the input outline.
		2. Focused or filled fields shift the shell to the fieldset border.
		3. The legend stays transparent so the notch remains native.
		4. Token changes drive color, while the existing focus-width math drives geometry.
	*/

	/* Field theme hooks and active tokens
	************************************************************/
	fieldset {
		/* Geometry
		███████████████████████████████████████████████████████████████████████ */
		--border-width: var(--border-width-xs);
		--border-focus-width: 2px;
		--active-border-width: var(--border-width);
		--radius: 0.75rem;
		--notch-padding: 0.25rem;
		--notch-indent: 0.75rem;
		--input-pad-y: 1rem;
		--input-height: 48px;
		--focus-offset: calc(var(--border-focus-width) - var(--border-width));
		--icon-size: 24px;
		--icon-gap: 0.5rem;
		--prefix-width: 0px;
		--suffix-width: 0px;
		--content-start: calc(var(--notch-indent) + var(--notch-padding));
		--content-end: var(--notch-indent);
		--input-pad-start: calc(var(--content-start) + var(--prefix-width));
		--input-pad-end: calc(var(--content-end) + var(--suffix-width));
		--legend-start: calc(var(--content-start) - var(--notch-padding));
		--legend-initial-offset-x: var(--prefix-width);

		@apply h-(--input-height) 
		relative mb-6 block w-full rounded-xl pointer-events-none border-transparent;
		border-width: var(--active-border-width);
		
		&:has(:global(.start)) {
			--prefix-width: calc(var(--icon-size) + var(--icon-gap));
		}

		&:has(:global(.end)) {
			--suffix-width: calc(var(--icon-size) + var(--icon-gap));
		}
	}

	/* Defaults
	************************************************************/
	fieldset legend {
		@apply ml-(--legend-start) px-(--notch-padding) text-base-500-500 text-xs font-semibold
		relative z-2 leading-0 bg-transparent transition-transform pointer-events-none whitespace-nowrap origin-top-left;
	}

	fieldset label {
		@apply absolute inset-0 z-0 block pointer-events-auto;
	}

	fieldset :global {
		.icon.start,
		.icon.end {
			@apply size-(--icon-size) text-base-400-500
			absolute top-1/2 z-2 block shrink-0 leading-none transition-colors -translate-y-1/2;
		}

		.icon.start { left: var(--content-start); }
		.icon.end { right: var(--content-end); }
	}

	fieldset input {
		@apply py-(--input-pad-y) pl-(--input-pad-start) pr-(--input-pad-end) bg-white text-base-900-50 rounded-xl
		border-0 outline-0 size-full relative z-0 transition-colors;

		&::placeholder {
			@apply text-transparent;
		}
	}

	fieldset:has(:global(.start)) label input {
		padding-inline-start: calc(var(--input-pad-start) + var(--notch-padding));
	}

	/* Geometry only
	************************************************************/

	/* initial */
	fieldset:has(input:placeholder-shown) {
		legend { @apply translate-x-(--legend-initial-offset-x) translate-y-6 scale-135 opacity-50; }
		input { @apply outline-1 outline-base-300-700; }
	}

	/* focused */
	fieldset:is(
		:has(input:focus), 
		:has(input:not(:placeholder-shown))) {
			legend { @apply translate-0 scale-100 opacity-100; } /* reset the legend's position and opacity when the input is focused or has content */
			input { @apply outline-0; } /* remove the outline when focused or filled, since the fieldset border will take over */
	}

	/* filled (not focused) */
	fieldset:not(:has(input:focus)):has(input:not(:placeholder-shown)) {
		@apply border-success; 

		legend,
		:global(.icon.start),
		:global(.icon.end) {
			@apply text-success; 
		}
	}

	fieldset:has(input:focus) {
		--active-border-width: var(--border-focus-width);
		@apply border-info-500-600;

		legend {
			@apply text-info-500-600;
			/* margin-left: calc(var(--legend-start) - 1px); */
		}

		label {
			/* top: -2px; left: -2px; */
			/* top: calc(var(--focus-offset) * -1);
			left: calc(var(--focus-offset) * -1);
			width: calc(100% + (var(--focus-offset) * 2));
			height: calc(100% + (var(--focus-offset) * 2)); */
		}

		:global(.icon.start),
		:global(.icon.end) {
			@apply text-info-500-600;
		}
	}

	/* States (tokens only)
	************************************************************/
	/* 🟡⚪ Hover + Blur + Empty */
	fieldset:hover:not(:has(input:disabled)):not(:has(input:focus)):not(:has(input:not(:placeholder-shown))) {
		legend,
		:global(.icon.start),
		:global(.icon.end) {
			@apply text-base-500-600;
		}

		input {
			@apply outline-base-500-600;
		}
	}

	/* ⬛⚪✅👤 Value + Blur + User Valid */
	fieldset:not(:has(input:focus)):has(input:is(:valid, :user-valid):not(:placeholder-shown)) {
		@apply border-base-500-600;

		legend,
		:global(.icon.start),
		:global(.icon.end) {
			@apply text-base-500-600;
		}
	}

	/* ⚪❌👤🔒 Blur + User Invalid + Required */
	fieldset:not(:has(input:disabled)):not(:has(input:focus)):has(input:required:user-invalid),
	fieldset:not(:has(input:disabled)):not(:has(input:focus)):has(input[aria-invalid='true']) {
		@apply border-danger-500-600;

		legend,
		:global(.icon.start),
		:global(.icon.end) {
			@apply text-danger-500-600;
		}
	}

	/* ❌ Keep invalid labels fully opaque in every state */
	fieldset:has(input:required:user-invalid) legend,
	fieldset:has(input[aria-invalid='true']) legend {
		@apply opacity-100;
	}

	/* ⚪🚫 Disabled */
	fieldset:has(input:disabled) {
		@apply border-base-200-700;

		legend,
		:global(.icon.start),
		:global(.icon.end) {
			@apply text-base-200-700;
		}

		label {
			@apply pointer-events-none;
		}

		input {
			@apply bg-base-100-900 text-base-300-600 cursor-not-allowed;
		}
	}

	fieldset:has(input:disabled):has(input:placeholder-shown) input {
		@apply outline-base-200-700;
	}
</style>