{
  "name": "template",
  "scripts": {
    "dev": "turbo watch //#barrels:watch dev",
    "watch": "turbo watch //#barrels:watch dev storybook#story",
    "build": "turbo build",
    "preview": "turbo preview --filter=site",
    "preview:all": "turbo preview",
    "app": "turbo watch //#barrels:watch app#dev",
    "app:build": "turbo build --filter=app",
    "app:preview": "turbo preview --filter=app",
    "site": "turbo watch //#barrels:watch site#dev",
    "site:build": "turbo build --filter=site",
    "site:preview": "turbo preview --filter=site",
    "report": "turbo watch //#barrels:watch report#dev",
    "play": "turbo watch //#barrels:watch play#dev",
    "sb": "turbo watch //#barrels:watch storybook#dev",
    "barrels": "pnpm --filter @layerd/tools run barrels:run --workspace",
    "barrels:watch": "pnpm --filter @layerd/tools run barrels:run --workspace --watch",
    "sheetari": "pnpm --filter @layerd/tools sheetari",
    "stories": "turbo storybook#story",
    "symlinks": "turbo symlinks",
    "symlinks:clean": "turbo symlinks:clean",
    "symlinks:check": "turbo symlinks:check",
    "update": "pnpm up --latest -r",
    "reset": "git clean -fdx",
    "clean": "git clean -fdX",
    "clear": "git clean -fd"
  },
  "devDependencies": {
    "@csstools/postcss-light-dark-function": "^3.0.0",
    "@iconify-json/carbon": "^1.2.18",
    "@iconify-json/devicon": "^1.2.58",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@tailwindcss/postcss": "4.1.18",
    "postcss": "^8.5.6",
    "turbo": "2.8.3",
    "unplugin-icons": "^23.0.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}