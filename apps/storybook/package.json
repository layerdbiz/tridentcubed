{
  "name": "storybook",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "story": "stories",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "preview": "npx http-server storybook-static -p 6007 -o",
    "sync": "svelte-kit sync",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.0.0",
    "@layerd/config-svelte": "workspace:*",
    "@layerd/config-vite": "workspace:*",
    "@layerd/tools": "workspace:*",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/addon-themes": "^10.2.0",
    "@storybook/sveltekit": "^10.2.0",
    "@sveltejs/adapter-vercel": "^6.3.0",
    "@sveltejs/kit": "^2.49.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.1.18",
    "storybook": "^10.2.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@layerd/ui": "workspace:*"
  }
}
