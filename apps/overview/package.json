{
	"name": "overview",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"scripts": {
		"dev": "vp dev --open",
		"dev:host": "vp dev --host --open",
		"build": "vp build",
		"preview": "vp preview --host --open",
		"sync": "svelte-kit sync",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@csstools/postcss-light-dark-function": "^3.0.0",
		"@layerd/config-vite": "workspace:*",
		"@sveltejs/kit": "^3.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"@iconify-json/devicon": "^1.2.58",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@layerd/ui": "workspace:*",
		"valibot": "^1.2.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
