{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#ui.css": "@layerd/ui/theme.css"
	},
	"scripts": {
		"dev": "vite dev --open",
		"dev:host": "vite dev --host --open",
		"build": "vite build",
		"preview": "vite preview --host --open",
		"sync": "svelte-kit sync",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@csstools/postcss-light-dark-function": "^3.0.0",
		"@layerd/config-svelte": "workspace:*",
		"@layerd/config-vite": "workspace:*",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "4.3.3",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vite-plugin-devtools-json": "^1.1.0"
	},
	"dependencies": {
		"@iconify-json/devicon": "^1.2.58",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@layerd/ui": "workspace:*",
		"valibot": "^1.2.0"
	}
}
